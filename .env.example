# PostgreSQL (Docker Compose defaults)
DATABASE_URL="postgresql://artprint:artprint_dev@localhost:5432/artprint?schema=public"
DIRECT_URL="postgresql://artprint:artprint_dev@localhost:5432/artprint?schema=public"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"

# Authentication (generate at least 32 random bytes for production)
SESSION_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"
SESSION_COOKIE_NAME="artprint_session"

# Explicit development-only fallbacks
DEMO_MODE="false"
PAYMENT_PROVIDER="sandbox"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH=".data/uploads"

# Wompi (leave empty until configured)
WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_ENVIRONMENT="sandbox"

# Mercado Pago (leave empty until configured)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# S3-compatible storage (optional)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
